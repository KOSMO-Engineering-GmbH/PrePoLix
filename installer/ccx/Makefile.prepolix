# Builds ccx for PrePoLix, called by scripts/build_ccx.sh in the patched ccx_<VERSION>/src with
# PREFIX (the libraries built before), CC, FC, AR, LDOMP (OpenMP flag for linking, empty when
# LINK names libgomp.a itself) and LINK (static linking flags).
#
# Flags as in conda-forge's Makefile_MT of the same recipe (see its comments): -O2, -cpp for
# move.f, -DNETWORKOUT, -DUSE_MT=1 with spoolesMT.a for the threaded SPOOLES solver; in addition
# -DPASTIX for the PaStiX solver.
CFLAGS = -w -O2 -fopenmp -I$(PREFIX)/include/spooles -I$(PREFIX)/include -DARCH="Linux" \
	-DSPOOLES -DARPACK -DMATRIXSTORAGE -DNETWORKOUT -DUSE_MT=1 -DPASTIX
FFLAGS = -w -O2 -fopenmp -cpp -fallow-argument-mismatch
LDOMP = -fopenmp

.c.o :
	$(CC) $(CFLAGS) -c $<
.f.o :
	$(FC) $(FFLAGS) -c $<

include Makefile.inc

SCCXMAIN = ccx_$(VERSION).c

OCCXF = $(SCCXF:.f=.o)
OCCXC = $(SCCXC:.c=.o)
OCCXMAIN = $(SCCXMAIN:.c=.o)

LIBS = $(PREFIX)/lib/libpastix.a $(PREFIX)/lib/libpastix_kernels.a $(PREFIX)/lib/libspm.a \
	$(PREFIX)/lib/libscotch.a $(PREFIX)/lib/libscotcherrexit.a \
	$(PREFIX)/lib/spoolesMT.a $(PREFIX)/lib/spooles.a \
	$(PREFIX)/lib/libarpack.a $(PREFIX)/lib/libopenblas.a -lpthread -lm

ccx_$(VERSION)_prepolix: $(OCCXMAIN) ccx_$(VERSION)_prepolix.a
	$(FC) $(LDOMP) -o $@ $(OCCXMAIN) ccx_$(VERSION)_prepolix.a $(LIBS) $(LINK)

ccx_$(VERSION)_prepolix.a: $(OCCXF) $(OCCXC)
	$(AR) r $@ $?
