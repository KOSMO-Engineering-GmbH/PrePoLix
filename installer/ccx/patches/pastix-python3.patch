--- a/cmake_modules/morse_cmake/modules/precision_generator/genDependencies.py
+++ b/cmake_modules/morse_cmake/modules/precision_generator/genDependencies.py
@@ -19,7 +19,7 @@ import re;
 import shlex;
 import os;
 import shutil;
