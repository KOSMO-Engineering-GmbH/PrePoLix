Makes PaStiX's code generator run with Python 3.7 and newer: the module imp is gone in 3.12, and
re.sub rejects the escape \s in a replacement since 3.7 (it only occurs in '#\s*define'). For
scripts/build_ccx.sh.

diff --git a/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py b/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py
index 5921fe1..b0f3740 100644
--- a/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py
+++ b/cmake_modules/morse_cmake/modules/precision_generator/Conversion.py
@@ -245,6 +245,7 @@ class Conversion:
         if sub_type != 'tracing' :
           replace = replace.replace('\(','(');
           replace = replace.replace('\)',')');
+        replace = replace.replace('\\s*', '');
         data = re.sub(search, replace, data);
       except:
         print('Bad replacement pair ',i,'in',sub_type);
