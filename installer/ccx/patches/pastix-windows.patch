diff --git a/common/models.c b/common/models.c
index eb4557f..3b73b45 100644
--- a/common/models.c
+++ b/common/models.c
@@ -15,6 +15,36 @@
 #include "common.h"
 #include "models.h"
 
+#if defined(_WIN32)
+/* MinGW has no getline: reads a line into *str, which grows as needed. */
+static inline long
+pastix_getline( char **str, size_t *size, FILE *f )
+{
+    size_t len = 0;
+    int    c;
+    while ( ( c = fgetc( f ) ) != EOF ) {
+        if ( len + 2 > *size ) {
+            char *grown = realloc( *str, 2 * ( *size ) + 2 );
+            if ( grown == NULL ) {
+                return -1;
+            }
+            *str  = grown;
+            *size = 2 * ( *size ) + 2;
+        }
+        ( *str )[len++] = (char)c;
+        if ( c == '\n' ) {
+            break;
+        }
+    }
+    if ( len == 0 ) {
+        return -1;
+    }
+    ( *str )[len] = '\0';
+    return (long)len;
+}
+#define getline pastix_getline
+#endif
+
