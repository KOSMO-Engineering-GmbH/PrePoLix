@@ -17,6 +17,22 @@
 #include "spm_drivers.h"
 #include "drivers/laplacian.h"
 
+#if defined(_WIN32)
+/* MinGW has no strndup. */
+static inline char *
+spm_strndup( const char *str, size_t n )
+{
+    size_t len = strnlen( str, n );
+    char  *copy = malloc( len + 1 );
+    if ( copy != NULL ) {
+        memcpy( copy, str, len );
+        copy[len] = '\0';
+    }
+    return copy;
+}
+#define strndup spm_strndup
+#endif
