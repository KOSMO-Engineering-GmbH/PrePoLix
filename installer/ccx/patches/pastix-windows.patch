Builds PaStiX4CalculiX with MinGW for Windows, which lacks a few POSIX functions: setenv
(via _putenv_s), strndup, mkdtemp (via _mktemp_s and _mkdir), getline and random/srandom (via
rand/srand); and no reference to index() (a POSIX function that only happens to exist on Linux)
in the tracing stub. Everything new is under _WIN32. For scripts/build_ccx.sh.

diff --git a/common/api.c b/common/api.c
index 12c60ef..ac9e6ba 100644
--- a/common/api.c
+++ b/common/api.c
@@ -27,6 +27,20 @@
 #include <sys/types.h>
 #include <sys/stat.h>
 #include "models.h"
+
+#if defined(_WIN32)
+#include <direct.h>
+/* MinGW has no mkdtemp. */
+static inline char *
+pastix_mkdtemp( char *template )
+{
+    if ( ( _mktemp_s( template, strlen( template ) + 1 ) != 0 ) || ( _mkdir( template ) != 0 ) ) {
+        return NULL;
+    }
+    return template;
+}
+#define mkdtemp pastix_mkdtemp
+#endif
 #if defined(PASTIX_WITH_PARSEC)
 #include "sopalin/parsec/pastix_parsec.h"
 #endif
diff --git a/common/common.h b/common/common.h
index 5d98009..49cd4bc 100644
--- a/common/common.h
+++ b/common/common.h
@@ -87,7 +87,14 @@ pastix_cleanenv( char *str ) {
 
 static inline int
 pastix_setenv( const char *var, const char *value, int overwrite ) {
+#if defined(_WIN32)
+    if ( !overwrite && getenv( var ) ) {
+        return 0;
+    }
+    return _putenv_s( var, value );
+#else
     return setenv( var, value, overwrite );
+#endif
 }
 
